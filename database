-- Create a view for bunch status summary
CREATE OR REPLACE VIEW project_item_bunches AS
SELECT 
    project_id,
    subcontractorType as bunch_type,
    status,
    assigned_to_role,
    COUNT(*) as item_count,
    COUNT(CASE WHEN status LIKE '%_approved' THEN 1 END) as approved_count,
    COUNT(CASE WHEN status = 'modification_requested' THEN 1 END) as modification_count,
    COUNT(CASE WHEN status LIKE 'pending_%' THEN 1 END) as pending_count,
    MIN(created_at) as first_item_created,
    MAX(updated_at) as last_updated
FROM project_items 
WHERE subcontractorType IS NOT NULL
GROUP BY project_id, subcontractorType, status, assigned_to_role;

