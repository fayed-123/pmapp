-- Users table
CREATE TABLE users (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  phone TEXT,
  role TEXT NOT NULL CHECK (role IN ('consultant', 'owner', 'contractor', 'mainConsultant', 'generalConsultant', 'subcontractor', 'subConsultant', 'subconsultant', 'client', 'admin')),
  password TEXT NOT NULL,
  approved BOOLEAN DEFAULT false,
  is_main_consultant BOOLEAN DEFAULT false,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  parent_id UUID REFERENCES users(id),
  type VARCHAR
);

-- Projects table
CREATE TABLE projects (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  name TEXT NOT NULL,
  description TEXT,
  start_date DATE,
  end_date DATE,
  completion INTEGER DEFAULT 0,
  time_elapsed INTEGER DEFAULT 0,
  expected_days INTEGER DEFAULT 30,
  performance INTEGER DEFAULT 0,
  created_by UUID REFERENCES users(id),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  owner_id UUID REFERENCES users(id),
  consultant_id UUID REFERENCES users(id),
  contractor_id UUID REFERENCES users(id),
  status TEXT DEFAULT 'active',
  contract_value NUMERIC DEFAULT 0,
  advance_payment_percentage NUMERIC DEFAULT 0,
  work_guarantee_percentage NUMERIC DEFAULT 0,
  material_delivery_payment_percentage NUMERIC DEFAULT 0,
  completed_work_payment_percentage NUMERIC DEFAULT 0,
  general_consultant_id UUID REFERENCES users(id),
  main_consultant_id UUID REFERENCES users(id),
  contractorid UUID REFERENCES users(id),
  subcontractor_id UUID REFERENCES users(id),
  subconsultant_id UUID REFERENCES users(id),
  show_to_role TEXT,
  electricalconsultantid UUID REFERENCES users(id),
  architectconsultantid UUID REFERENCES users(id),
  mechanicalconsultantid UUID REFERENCES users(id),
  architect_consultant_id UUID REFERENCES users(id),
  electricalcontractorid UUID REFERENCES users(id),
  architectcontractorid UUID REFERENCES users(id),
  mechanicalcontractorid UUID REFERENCES users(id)
);

-- Project items table
CREATE TABLE project_items (
  id TEXT PRIMARY KEY,
  project_id TEXT NOT NULL,
  item_number TEXT NOT NULL,
  name TEXT NOT NULL,
  progress NUMERIC DEFAULT 0,
  weight NUMERIC DEFAULT 0,
  start_date TEXT,
  end_date TEXT,
  execution_time INTEGER DEFAULT 0,
  weighted_progress NUMERIC DEFAULT 0,
  risk_level TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  subcontractorType TEXT,
  contractorid UUID REFERENCES users(id),
  status TEXT DEFAULT 'pending',
  comments TEXT,
  submitted_by UUID REFERENCES users(id),
  reviewed_by UUID REFERENCES users(id),
  reviewed_at TIMESTAMP WITH TIME ZONE,
  value NUMERIC,
  supplyProgress NUMERIC,
  subcontractorId UUID REFERENCES users(id)
);

-- Contacts table
CREATE TABLE contacts (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  project_id UUID REFERENCES projects(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  phone TEXT,
  role TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Notifications table
CREATE TABLE notifications (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  title TEXT NOT NULL,
  message TEXT NOT NULL,
  type TEXT NOT NULL CHECK (type IN ('task_assigned', 'project_update', 'system', 'reminder')),
  from_user_id UUID REFERENCES users(id),
  from_user_name TEXT,
  from_user_role TEXT,
  to_user_id UUID REFERENCES users(id) NOT NULL,
  project_id UUID REFERENCES projects(id),
  project_name TEXT,
  task_id TEXT,
  data JSONB,
  is_read BOOLEAN DEFAULT false,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

